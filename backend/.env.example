# Django
# Obligatoria si DEBUG=False. Genera una de 50+ caracteres, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as f; print(f())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del admin en producción (secreta, para no dejarlo en /admin/).
ADMIN_URL=admin/

# Nº de proxies de confianza delante de Django, para el throttling por IP
# (rest_framework NUM_PROXIES). SIEMPRE 1: es un fallback, solo se usa
# cuando la petición no trae BFF_SHARED_SECRET (o lo trae incorrecto), y en
# ese caso el único salto real hasta Django es el borde de Render (la URL
# pública *.onrender.com se puede llamar directamente sin pasar por el BFF
# de Vercel). Ponerlo en 2 asumiendo siempre "BFF -> Render" deja que
# cualquiera que llame directo al backend se salte el throttle
# inventándose X-Forwarded-For. El valor por defecto del código ya es 1 si
# no se define esta variable.
NUM_PROXIES=1

# Secreto compartido con el BFF de Next.js (mismo valor en el .env del
# frontend y, en producción, en Vercel y Render). Con él, el throttle de
# auth (users/throttling.py) confía en la cabecera X-Bff-Client-Ip como IP
# real del visitante; sin configurar (vacío), todas las peticiones que
# lleguen desde el BFF comparten un único contador por su IP de salida.
BFF_SHARED_SECRET=

# Base de datos
# En Render/Neon: define DATABASE_URL (con ?sslmode=require) y olvida las
# POSTGRES_*. En local (docker-compose o venv) se usan las POSTGRES_* si
# DATABASE_URL no está definida.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
POSTGRES_DB=fightlab
POSTGRES_USER=fightlab
POSTGRES_PASSWORD=fightlab
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend base URL (enlaces de verificación de email y CORS por defecto)
FRONTEND_URL=http://localhost:3000

# CORS (orígenes separados por comas que pueden llamar a la API).
# En producción normalmente vacío: el BFF de Next llama servidor a servidor,
# sin cookies ni CORS de Django.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF: orígenes de confianza en producción (con esquema), separados por comas.
# Ejemplo: https://fightlab-api.onrender.com
CSRF_TRUSTED_ORIGINS=

# Beta cerrada por invitación: emails separados por comas que pueden
# registrarse. Vacía + DEBUG=True -> se permite cualquiera.
# Vacía + DEBUG=False -> no se permite a nadie.
BETA_ALLOWED_EMAILS=

# Email verification link validity (seconds)
EMAIL_VERIFICATION_TIMEOUT=86400

# Email: 'smtp' (por defecto, este bloque), 'console' o, para producción en
# el plan free de Render (bloquea el SMTP saliente en 25/465/587), 'brevo'
# o 'resend' (envío por API HTTP vía django-anymail).
EMAIL_PROVIDER=smtp
EMAIL_TIMEOUT=10
# Con EMAIL_PROVIDER=smtp: en blanco = consola (el enlace se imprime en el
# log del backend). Con SMTP (Gmail): EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# y una contraseña de aplicación de Gmail en EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Con EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Con EMAIL_PROVIDER=resend (opcional, alternativa a Brevo)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=FightLab Pro <no-reply@fightlab.local>

# IA (Anthropic). Sin clave, los endpoints de IA responden 503.
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-sonnet-5
AI_MODEL_VISION=claude-sonnet-5

# Nivel de log a consola
DJANGO_LOG_LEVEL=INFO
