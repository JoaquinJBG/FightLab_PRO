# URL base de la API de Django, INCLUYENDO /api/v1.
# En producción es obligatoria: sin ella el BFF falla al arrancar en vez de
# hablar en silencio con localhost. En desarrollo, si se omite, se usa
# http://127.0.0.1:8001/api/v1 (backend local en el puerto 8001; el 8000 lo
# ocupa otro proyecto).
DJANGO_API_URL=http://127.0.0.1:8001/api/v1

# Secreto compartido con el backend (misma variable BFF_SHARED_SECRET en
# Render). Tiene que ser EXACTAMENTE el mismo valor en Vercel y en Render: el
# BFF lo manda junto con la IP real del visitante (ver lib/auth-forward.ts) en
# cada llamada a Django que dependa del throttling por IP (login, register,
# resend, password-reset, verify-email, refresh y el proxy genérico). Django
# solo se fía de esa IP cuando el secreto coincide (ver
# backend/users/throttling.py). SECRETO: nunca con prefijo NEXT_PUBLIC_.
# Sin este valor (aquí o en Render), Django ve la IP de salida del propio BFF
# en vez de la del visitante y el throttle de login/registro/reset se
# comparte entre toda la beta; el comportamiento actual (sin cabeceras de IP)
# se mantiene si se deja vacío.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_SHARED_SECRET=

# Avisos con Web Push (fase 11), opcionales: sin ellas los avisos quedan
# apagados y la app lo explica en Perfil → Avisos (ver docs/DEPLOY.md).
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY: la clave PÚBLICA VAPID, la misma que
#   VAPID_PUBLIC_KEY en Render. Es pública (va en el JS del navegador) y se
#   lee en el build: tras cambiarla hay que redesplegar.
# - CRON_SECRET: secreto que Vercel manda a las tareas de vercel.json
#   (Authorization: Bearer ...). Sin él, /api/cron/* responde 503. Las
#   tareas llaman al backend con BFF_SHARED_SECRET, que también hace falta.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=

# NODE_ENV lo gestiona el propio runtime (Vercel lo pone a "production" solo);
# no hace falta fijarlo a mano salvo en local si se quiere probar la rama de
# producción de next.config.ts (headers de seguridad) o el error de
# DJANGO_API_URL ausente.
# NODE_ENV=production
